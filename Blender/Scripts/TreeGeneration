import bpy
import csv
import os
from mathutils import Vector

# --- CONFIGURACIÓN ---
csv_filepath = r"C:\Users\57321\Downloads\tree_positions.csv"

REF_LAT = 7.140857685046179
REF_LON = -73.12046867300049

SCALE_FACTOR_LON = 110461.93
SCALE_FACTOR_LAT = 110591.46

TERRAIN_OBJECT_NAME = "Terrain"
BUILDING_KEYWORDS = ["building", "edificio", "construct", "house"] 

# Radio de seguridad alrededor del árbol en metros (para evitar que las ramas toquen o entren en un edificio)
TREE_SAFETY_RADIUS = 1.5  

collection_name = "Trees_Normalized"
if collection_name not in bpy.data.collections:
    new_collection = bpy.data.collections.new(collection_name)
    bpy.context.scene.collection.children.link(new_collection)
else:
    new_collection = bpy.data.collections[collection_name]

def create_master_complex_tree():
    """Crea UN SOLO objeto maestro complejo con Geometry Nodes para reutilizarlo como instancia."""
    mesh_data = bpy.data.meshes.new("Tree_Master_Mesh")
    master_obj = bpy.data.objects.new("Tree_Master", mesh_data)
    
    master_obj.hide_viewport = True
    master_obj.hide_render = True
    new_collection.objects.link(master_obj)
    
    mod = master_obj.modifiers.new(name="ComplexTreeGenerator", type='NODES')
    
    group = bpy.data.node_groups.new(name="Master_Tree_GeoNodes", type='GeometryNodeTree')
    group.interface.new_socket(name="Geometry", in_out='OUTPUT', socket_type='NodeSocketGeometry')
    
    nodes = group.nodes
    links = group.links
    
    group_output = nodes.new('NodeGroupOutput')
    group_output.location = (900, 0)
    
    # Tronco
    trunk_node = nodes.new('GeometryNodeMeshCylinder')
    trunk_node.location = (-300, -200)
    trunk_node.inputs['Radius'].default_value = 0.35
    trunk_node.inputs['Depth'].default_value = 5.0
    
    trunk_transform = nodes.new('GeometryNodeTransform')
    trunk_transform.location = (-50, -200)
    trunk_transform.inputs['Translation'].default_value = (0.0, 0.0, 2.5)
    
    # Capas de follaje
    foliage1 = nodes.new('GeometryNodeMeshCone')
    foliage1.location = (-300, 0)
    foliage1.inputs['Radius Top'].default_value = 0.0
    foliage1.inputs['Radius Bottom'].default_value = 2.4
    foliage1.inputs['Depth'].default_value = 3.5
    
    trans_f1 = nodes.new('GeometryNodeTransform')
    trans_f1.location = (-50, 0)
    trans_f1.inputs['Translation'].default_value = (0.0, 0.0, 3.2)
    
    foliage2 = nodes.new('GeometryNodeMeshCone')
    foliage2.location = (-300, 150)
    foliage2.inputs['Radius Top'].default_value = 0.0
    foliage2.inputs['Radius Bottom'].default_value = 1.8
    foliage2.inputs['Depth'].default_value = 3.0
    
    trans_f2 = nodes.new('GeometryNodeTransform')
    trans_f2.location = (-50, 150)
    trans_f2.inputs['Translation'].default_value = (0.0, 0.0, 5.5)
    
    foliage3 = nodes.new('GeometryNodeMeshCone')
    foliage3.location = (-300, 300)
    foliage3.inputs['Radius Top'].default_value = 0.0
    foliage3.inputs['Radius Bottom'].default_value = 1.1
    foliage3.inputs['Depth'].default_value = 2.5
    
    trans_f3 = nodes.new('GeometryNodeTransform')
    trans_f3.location = (-50, 300)
    trans_f3.inputs['Translation'].default_value = (0.0, 0.0, 7.5)
    
    # Uniones
    join_1 = nodes.new('GeometryNodeJoinGeometry')
    join_1.location = (200, 0)
    
    join_2 = nodes.new('GeometryNodeJoinGeometry')
    join_2.location = (500, 0)
    
    links.new(trunk_node.outputs['Mesh'], trunk_transform.inputs['Geometry'])
    links.new(foliage1.outputs['Mesh'], trans_f1.inputs['Geometry'])
    links.new(foliage2.outputs['Mesh'], trans_f2.inputs['Geometry'])
    links.new(foliage3.outputs['Mesh'], trans_f3.inputs['Geometry'])
    
    links.new(trunk_transform.outputs['Geometry'], join_1.inputs['Geometry'])
    links.new(trans_f1.outputs['Geometry'], join_1.inputs['Geometry'])
    
    links.new(join_1.outputs['Geometry'], join_2.inputs['Geometry'])
    links.new(trans_f2.outputs['Geometry'], join_2.inputs['Geometry'])
    links.new(trans_f3.outputs['Geometry'], join_2.inputs['Geometry'])
    
    links.new(join_2.outputs['Geometry'], group_output.inputs['Geometry'])
    
    mod.node_group = group
    return master_obj

def is_obj_or_parent_building(obj):
    """Verifica si el objeto golpeado o alguna colección contenedora pertenece a un edificio."""
    if not obj:
        return False
    name_lower = obj.name.lower()
    if any(keyword in name_lower for keyword in BUILDING_KEYWORDS):
        return True
    for coll in obj.users_collection:
        coll_name_lower = coll.name.lower()
        if any(keyword in coll_name_lower for keyword in BUILDING_KEYWORDS):
            return True
    return False

# --- EJECUCIÓN PRINCIPAL ---
context = bpy.context

terrain_obj = bpy.data.objects.get(TERRAIN_OBJECT_NAME)
if not terrain_obj:
    print(f"Error: No se encontró el objeto de terreno '{TERRAIN_OBJECT_NAME}' en la escena.")
elif not os.path.exists(csv_filepath):
    print(f"Error: No se encontró el archivo CSV en la ruta especificada: {csv_filepath}")
else:
    master_tree = create_master_complex_tree()
    
    bpy.context.window.cursor_set("WAIT")
    depsgraph = context.evaluated_depsgraph_get()
    
    locations = []
    skipped_no_hit = 0
    skipped_building = 0
    
    # Generar desplazamientos relativos para comprobar 5 puntos (Centro + 4 puntos cardinales)
    # Esto forma una cruz del tamaño del radio del árbol (ej. 1.5 metros)
    check_offsets = [
        (0.0, 0.0),                               # Centro
        (TREE_SAFETY_RADIUS, 0.0),                # Este
        (-TREE_SAFETY_RADIUS, 0.0),               # Oeste
        (0.0, TREE_SAFETY_RADIUS),                # Norte
        (0.0, -TREE_SAFETY_RADIUS)                # Sur
    ]
    
    with open(csv_filepath, mode='r', encoding='utf-8') as file:
        reader = csv.DictReader(file)
        for row in reader:
            lon = float(row['lon'])
            lat = float(row['lat'])
            
            base_x = (lon - REF_LON) * SCALE_FACTOR_LON
            base_y = (lat - REF_LAT) * SCALE_FACTOR_LAT
            
            # Verificar todos los puntos de la zona del árbol
            zone_valid = True
            center_z = 0.0
            
            for dx, dy in check_offsets:
                sample_x = base_x + dx
                sample_y = base_y + dy
                
                ray_start = Vector((sample_x, sample_y, 10000.0))
                ray_direction = Vector((0.0, 0.0, -1.0))
                hit, hit_location, _, _, hit_object, _ = context.scene.ray_cast(depsgraph, ray_start, ray_direction)
                
                # Si alguno de los puntos cae fuera del terreno o choca con un edificio, toda la zona se invalida
                if not hit or hit_object is None or is_obj_or_parent_building(hit_object) or hit_object != terrain_obj:
                    zone_valid = False
                    break
                
                # Guardar la altura del centro exacto
                if dx == 0.0 and dy == 0.0:
                    center_z = hit_location.z
            
            if not zone_valid:
                # Determinar si fue por edificio o por falta de terreno para las estadísticas
                # (Evaluación rápida del centro para saber la causa aproximada de omisión)
                ray_start_c = Vector((base_x, base_y, 10000.0))
                hit_c, _, _, _, hit_obj_c, _ = context.scene.ray_cast(depsgraph, ray_start_c, Vector((0.0, 0.0, -1.0)))
                if not hit_c or hit_obj_c != terrain_obj:
                    skipped_no_hit += 1
                else:
                    skipped_building += 1
                continue
                
            locations.append((base_x, base_y, center_z))

    # Instanciar únicamente los árboles cuya zona completa está 100% libre
    added_count = 0
    for loc in locations:
        tree_instance = master_tree.copy()
        tree_instance.data = master_tree.data
        tree_instance.location = loc
        
        tree_instance.hide_viewport = False
        tree_instance.hide_render = False
        
        new_collection.objects.link(tree_instance)
        added_count += 1

    bpy.context.window.cursor_set("DEFAULT")
    print(f"¡Proceso completado con validación zonal!")
    print(f"- Árboles seguros generados: {added_count}")
    print(f"- Omitidos por fuera del terreno: {skipped_no_hit}")
    print(f"- Omitidos por proximidad o colisión con edificios: {skipped_building}")